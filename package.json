{
  "name": "team-umalysis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "node scripts/sync-icon.mjs && vite --host localhost",
    "dev:server": "tsx watch server/index.ts",
    "build": "node scripts/sync-icon.mjs && tsc --noEmit && vite build",
    "preview": "node scripts/sync-icon.mjs && vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "cors": "^2.8.5",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "express": "^4.21.2",
    "lodash": "^4.18.1",
    "memoize-one": "^6.0.0",
    "pako": "^2.1.0",
    "react": "^19",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19",
    "react-json-view-lite": "^2.5.0",
    "react-router-dom": "^7",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/lodash": "^4.17.23",
    "@types/node": "^22.10.2",
    "@types/pako": "^2.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.2"
  }
}
